// Fastfetch « bleu Arch » pour la Surface
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": { "1": "blue", "2": "blue" }
  },
  "display": {
    "color": { "keys": "blue", "title": "blue" },
    "separator": "  "
  },
  "modules": [
    "title", "separator",
    "os", "kernel", "uptime", "packages", "shell", "de", "wm", "terminal",
    "cpu", "gpu", "memory", "swap", "disk", "battery", "poweradapter", "localip",
    "break", "colors"
  ]
}
